<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>jp.noriball.anorthoscope.kiosk</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Applications/AnorthoscopeKiosk.app/Contents/MacOS/AnorthoscopeKiosk</string>
	</array>
	<!-- ログイン時に自動起動 -->
	<key>RunAtLoad</key>
	<true/>
	<!-- クラッシュ・強制終了などプロセスが消えたら自動的に再起動する -->
	<key>KeepAlive</key>
	<true/>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>StandardOutPath</key>
	<string>/tmp/anorthoscope-kiosk.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/anorthoscope-kiosk.err.log</string>
</dict>
</plist>
